# =====================================================================
# BLOOMI Application - Environment Configuration Template
# =====================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local':
#    cp .env.example .env.local
# 2. Replace the placeholder values below with your real Supabase project credentials.
#    You can retrieve these from: Supabase Dashboard > Project Settings > API
#
# IMPORTANT SECURITY NOTICE:
# - Only client-safe, public keys (VITE_*) should ever be placed here.
# - NEVER put the SUPABASE_SERVICE_ROLE_KEY or any database connection string here.
# - The .env.local file is ignored by Git and must never be committed.
# =====================================================================

# Supabase Project URL (Example: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anonymous Key (Safe for browser client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here
